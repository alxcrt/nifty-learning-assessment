{
	"name": "nifty-learning-assessment",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "biome check .",
		"prepare": "husky",
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "node scripts/start.mjs",
		"check-types": "turbo check-types",
		"test": "turbo test",
		"test:server": "turbo -F server test",
		"test:watch": "turbo -F server test:watch",
		"test:coverage": "turbo -F server test:coverage",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F server db:push",
		"db:studio": "turbo -F server db:studio",
		"db:generate": "turbo -F server db:generate",
		"db:migrate": "turbo -F server db:migrate",
		"db:start": "turbo -F server db:start",
		"db:watch": "turbo -F server db:watch",
		"db:stop": "turbo -F server db:stop",
		"db:down": "turbo -F server db:down"
	},
	"dependencies": {
		"sirv-cli": "^3.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.11.10"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write"
		]
	},
	"packageManager": "bun@1.4.3"
}
